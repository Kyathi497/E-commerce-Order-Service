# Values for running on your machine (`pnpm dev`) against the Docker database
# (`docker compose up mysql`). Inside Docker Compose, hosts and ports are
# overridden in docker-compose.yml.
PORT=4006

DB_HOST=localhost
DB_PORT=3313
MYSQL_USER=order
MYSQL_PASSWORD=order
MYSQL_DATABASE=order

# auth-service's public keys, for knowing which shopper is signed in.
AUTH_JWKS_URL=http://localhost:4001/internal/.well-known/jwks.json
# Shared by all services for service-to-service calls. Required in production
# (at least 32 random characters, e.g. `openssl rand -base64 48`).
# SERVICE_TOKEN_SECRET=
# Signs the links that let a guest see their own order. Required in production.
# ORDER_LINK_SECRET=
ORDER_LINK_DAYS=30

# What checkout calls.
AUTH_URL=http://localhost:4001
CART_URL=http://localhost:4004
CATALOG_URL=http://localhost:4002
INVENTORY_URL=http://localhost:4003
PROMOTION_URL=http://localhost:4005
SHIPPING_URL=http://localhost:4008
PAYMENT_URL=http://localhost:4007
# Shipping charged when shipping-service can't be reached.
FALLBACK_SHIPPING_PAISE=7000

# Cash on delivery: on/off, order limit in paise, open COD orders per phone.
COD_ENABLED=true
COD_MAX_PAISE=200000
COD_MAX_OPEN_PER_PHONE=1

# GST state code of the store's GSTIN (37 = Andhra Pradesh).
STORE_STATE_CODE=37

# Unpaid orders are cancelled after this many minutes if inventory's expiry never arrives.
PENDING_TIMEOUT_MINUTES=60
SWEEP_SECONDS=10

# Who receives order events. Leave a consumer empty if it isn't running.
INVENTORY_EVENTS_URL=http://localhost:4003/internal/events
PROMOTION_EVENTS_URL=http://localhost:4005/internal/events
PAYMENT_EVENTS_URL=http://localhost:4007/internal/events
# NOTIFICATION_EVENTS_URL=http://localhost:4009/internal/events
# SHIPPING_EVENTS_URL=http://localhost:4008/internal/events
EVENT_RETRY_DELAYS=5,15,30,60
